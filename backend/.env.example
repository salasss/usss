# Copy to backend/.env (ignored by git). Never commit real values.
HOST=0.0.0.0
PORT=8080
RUST_LOG=usss_backend=debug,tower_http=info

# Supabase project URL: access tokens are verified with the project's JWKS
# signing keys (ES256/RS256) and their issuer is checked.
SUPABASE_URL=https://your-project.supabase.co
# Legacy projects signing tokens with a shared secret (HS256) only.
# SUPABASE_JWT_SECRET=
