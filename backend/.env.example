# Copy to backend/.env (ignored by git). Never commit real values.
HOST=0.0.0.0
PORT=8080
RUST_LOG=usss_backend=debug,tower_http=info

# Supabase project URL: access tokens are verified with the project's JWKS
# signing keys (ES256/RS256) and their issuer is checked.
SUPABASE_URL=https://your-project.supabase.co
# Legacy projects signing tokens with a shared secret (HS256) only.
# SUPABASE_JWT_SECRET=

# Supabase > Connect > "Session pooler" (or direct) connection string.
# The transaction pooler (port 6543) does not keep prepared statements.
DATABASE_URL=postgres://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: push notifications (docs/push-notifications.md). Firebase console >
# Project settings > Service accounts > Generate new private key, then put the
# base64 of that JSON file here (`base64 -w0 key.json`); a hosting platform's
# variables also accept the raw JSON. Without it, push is disabled.
# FCM_SERVICE_ACCOUNT=base64-of-the-service-account-key
