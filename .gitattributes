# Normalize line endings: LF in the repository and in working trees,
# so shell scripts and Gradle wrappers keep working on Linux CI runners.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.gif      binary
*.ttf      binary
*.otf      binary
*.jar      binary
*.keystore binary
*.jks      binary
