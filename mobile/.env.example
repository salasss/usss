# Copy to mobile/.env (ignored by git). EXPO_PUBLIC_* values are embedded in the
# APK at build time: only put public values here (never a service_role key).
# In CI they come from the GitHub repository secrets of the same name.

# Supabase project (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web OAuth client ID from Google Cloud Console (audience of the Google ID token)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=0000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
